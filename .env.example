# Copy this file to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------
# LLM provider (BeeAI ChatModel)
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_ID=anthropic:claude-sonnet-4-6
LLM_CHEAP_MODEL_ID=anthropic:claude-haiku-4-5-20251001

# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# Project URL (public, fine to commit to .env.example as-is)
SUPABASE_URL=https://xqrfmanrfppfxsozdmht.supabase.co

# Publishable (anon) key — used ONLY by the Next.js frontend (web/).
# Safe to ship to the browser because RLS gates everything.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_2usJY-A2CvpzqfT_orkXYg_qvt_Ts0S

# Service role key — server-only, bypasses RLS. NEVER put this in web/.
# Get it from Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------
# Embedding model (used for dedupe + similarity in paper_vectors)
# ---------------------------------------------------------------
# Options: "anthropic" (via Voyage), "openai", "local" (sentence-transformers).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ---------------------------------------------------------------
# Agent Stack server
# ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8333

# ---------------------------------------------------------------
# External MCP servers (agents consume these as extra tools)
# ---------------------------------------------------------------
# Path to the JSON config listing MCP servers to mount. Default: mcp_servers.json
# at repo root. See mcp_servers.example.json for the shape. If the file is
# missing, the agents run with no external MCP tools (fine).
# MCP_SERVERS_JSON=mcp_servers.json

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
# Default user id; in single-user mode the onboarding flow writes this row.
DEFAULT_USER_ID=
# Shared secret the daily_trigger Edge Function passes in the X-Daily-Secret
# header so the agent server knows the request is authorized.
DAILY_TRIGGER_SECRET=change-me
